# 复制为 .env 后填写(docker compose 会自动读取)
# DOMAIN:有域名填自己的;没有就注册一个免费的 DuckDNS 子域名(见 DEPLOY.md「一点五」)
DOMAIN=ballie.duckdns.org

# 可选:站点访问码(不填则不需要访问码)
# ACCESS_CODE=换成你的访问码

# 可选:管理令牌(用于 POST /api/config 等服务端管理接口)
# ADMIN_TOKEN=change-me-to-a-long-random-string

# 模型默认值(访客自带 Key 时仅作占位;站点内置 Key 一般不配置)
B_AI_BASE=https://api.b.ai/v1
B_AI_MODEL=qwen3.8-flash
# B_AI_KEY=sk-站点内置密钥(不填 = 纯 BYOK,所有访客用自己的 Key)

TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_ENABLED=1

# 限流默认全部关闭(纯 BYOK 无需限流);需要时再打开
# DAILY_LLM_LIMIT=500
# RATE_CHAT_PER_MIN=10
# RATE_TTS_PER_MIN=20
